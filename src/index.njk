    .nav-container{display:flex;justify-content:space-between;align-items:center}
    .logo{font-size:1.5rem;font-weight:800;color:var(--primary);display:flex;align-items:center;gap:0.5rem}
    .logo-icon{width:2.5rem;height:2.5rem;background:linear-gradient(135deg,var(--primary),var(--primary-light));border-radius:0.5rem;display:grid;place-items:center;color:white;font-size:1.25rem}
    .nav-links{display:flex;gap:2rem;list-style:none}
