# Enterprise PSEO Environment Configuration
# Using mock mode for all providers (no API keys needed)

# AI Provider API Keys - Leave empty to use mock data
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# External Services - Leave empty to use mock data
WEATHER_API_KEY=
MAPS_API_KEY=

# Cloudflare Deployment - Leave empty to skip deployment
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Application Settings
NODE_ENV=development
PORT=8080
