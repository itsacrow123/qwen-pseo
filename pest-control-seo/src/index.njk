---
layout: layouts/base.njk
title: "Professional Pest Control Services | Guardian Pest Control"
description: "Nationwide pest control services with licensed technicians. Residential & commercial treatments for termites, rodents, mosquitoes, bed bugs & more. Call for same-day service."
templateEngineOverride: njk
---

{% include "components/hero-home.njk" %}
{% include "components/trust-section.njk" %}
{% include "components/services-overview.njk" %}
{% include "components/common-pests.njk" %}
{% include "components/why-choose-us.njk" %}
{% include "components/service-areas.njk" %}
{% include "components/testimonials.njk" %}
{% include "components/cta-section.njk" %}

{% block schema %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "PestControl",
  "name": "{{ site.name }}",
  "description": "{{ site.description }}",
  "url": "{{ site.url }}",
  "telephone": "{{ site.phone | formatPhone }}",
  "email": "{{ site.email }}",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "{{ site.address.street }}",
    "addressLocality": "{{ site.address.city }}",
    "addressRegion": "{{ site.address.state }}",
    "postalCode": "{{ site.address.zip }}",
    "addressCountry": "US"
  },
  "areaServed": {
    "@type": "Country",
    "name": "United States"
  },
  "openingHours": "Mo-Su 00:00-23:59",
  "priceRange": "$$",
  "image": "{{ site.url }}/assets/images/og-default.jpg",
  "sameAs": [
    "{{ site.social.facebook }}",
    "{{ site.social.twitter }}",
    "{{ site.social.instagram }}",
    "{{ site.social.linkedin }}",
    "{{ site.social.youtube }}"
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Pest Control Services",
    "itemListElement": [
      {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Residential Pest Control"}},
      {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Commercial Pest Control"}},
      {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Termite Control"}},
      {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Mosquito Control"}},
      {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Rodent Control"}},
      {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Bed Bug Treatment"}}
    ]
  }
}
</script>
{% endblock %}
