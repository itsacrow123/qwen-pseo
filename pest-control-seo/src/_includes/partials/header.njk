<header class="site-header" role="banner">
  <div class="container">
    <div class="header-content">
      <!-- Logo -->
      <a href="/" class="logo" aria-label="{{ site.name }} Home">
        <svg width="180" height="40" viewBox="0 0 180 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <rect width="40" height="40" rx="8" fill="#1a5f3c"/>
          <path d="M20 8L24 16H16L20 8Z" fill="#f97316"/>
          <circle cx="20" cy="24" r="8" stroke="#f97316" stroke-width="2"/>
          <text x="50" y="26" font-family="Arial, sans-serif" font-size="18" font-weight="bold" fill="#1a5f3c">GUARDIAN</text>
        </svg>
      </a>
      
      <!-- Desktop Navigation -->
      <nav class="desktop-nav" role="navigation" aria-label="Main navigation">
        <ul class="nav-list">
          <li><a href="/services/">Services</a></li>
          <li><a href="/pests/">Pests We Treat</a></li>
          <li><a href="/commercial/">Commercial</a></li>
          <li><a href="/about/">About Us</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/contact/" class="nav-cta">Contact</a></li>
        </ul>
      </nav>
      
      <!-- Header Actions -->
      <div class="header-actions">
        <a href="tel:{{ site.phone | formatPhone }}" class="phone-link" aria-label="Call {{ site.phone }}">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          <span>{{ site.phone }}</span>
        </a>
        <a href="/quote/" class="btn btn-primary quote-btn">Get Free Quote</a>
        
        <!-- Mobile Menu Button -->
        <button class="mobile-menu-btn" aria-label="Toggle menu" aria-expanded="false">
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
        </button>
      </div>
    </div>
  </div>
  
  <!-- Trust Bar -->
  <div class="trust-bar">
    <div class="container">
      <ul class="trust-list">
        {% for badge in site.trustBadges %}
        <li class="trust-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
            <polyline points="22 4 12 14.01 9 11.01"/>
          </svg>
          <span>{{ badge }}</span>
        </li>
        {% endfor %}
      </ul>
    </div>
  </div>
</header>

<style>
.site-header { background: var(--bg); border-bottom: 1px solid var(--border); position: sticky; top: 0; z-index: 50; }
.header-content { display: flex; align-items: center; justify-content: space-between; padding: 1rem 0; gap: 2rem; }
.logo:hover { opacity: 0.9; }
.desktop-nav { display: none; }
.nav-list { display: flex; list-style: none; gap: 2rem; align-items: center; }
.nav-list a { color: var(--text); font-weight: 500; padding: 0.5rem 0; }
.nav-list a:hover { color: var(--primary); }
.nav-cta { background: var(--primary); color: white !important; padding: 0.5rem 1rem; border-radius: var(--radius); }
.header-actions { display: flex; align-items: center; gap: 1rem; }
.phone-link { display: flex; align-items: center; gap: 0.5rem; color: var(--text); font-weight: 600; font-size: 1.1rem; }
.phone-link:hover { color: var(--primary); }
.quote-btn { display: none; }
.mobile-menu-btn { display: flex; flex-direction: column; gap: 4px; background: none; border: none; padding: 0.5rem; }
.hamburger-line { width: 24px; height: 2px; background: var(--text); transition: 0.3s; }
.trust-bar { background: var(--bg-light); border-top: 1px solid var(--border); padding: 0.75rem 0; }
.trust-list { display: flex; flex-wrap: wrap; gap: 1.5rem; list-style: none; justify-content: center; }
.trust-item { display: flex; align-items: center; gap: 0.5rem; color: var(--text-light); font-size: 0.875rem; }
.trust-item svg { color: var(--success); flex-shrink: 0; }

@media (min-width: 1024px) {
  .desktop-nav { display: block; }
  .quote-btn { display: inline-block; background: var(--secondary); color: white; padding: 0.75rem 1.5rem; border-radius: var(--radius); font-weight: 600; transition: background 0.2s; }
  .quote-btn:hover { background: var(--secondary-hover); color: white; }
  .mobile-menu-btn { display: none; }
}
</style>
