<footer class="site-footer" role="contentinfo">
  <div class="container">
    <!-- Main Footer Content -->
    <div class="footer-grid">
      <!-- Company Info -->
      <div class="footer-col">
        <h3 class="footer-heading">{{ site.name }}</h3>
        <p class="footer-description">{{ site.description }}</p>
        <div class="footer-contact">
          <a href="tel:{{ site.phone | formatPhone }}" class="footer-phone">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            {{ site.phone }}
          </a>
          <a href="mailto:{{ site.email }}" class="footer-email">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
            {{ site.email }}
          </a>
        </div>
        <!-- Social Links -->
        <ul class="social-links">
          <li><a href="{{ site.social.facebook }}" aria-label="Facebook" rel="noopener noreferrer" target="_blank">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a></li>
          <li><a href="{{ site.social.twitter }}" aria-label="Twitter" rel="noopener noreferrer" target="_blank">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/></svg>
          </a></li>
          <li><a href="{{ site.social.instagram }}" aria-label="Instagram" rel="noopener noreferrer" target="_blank">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a></li>
          <li><a href="{{ site.social.linkedin }}" aria-label="LinkedIn" rel="noopener noreferrer" target="_blank">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a></li>
          <li><a href="{{ site.social.youtube }}" aria-label="YouTube" rel="noopener noreferrer" target="_blank">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a></li>
        </ul>
      </div>
      
      <!-- Services Links -->
      <div class="footer-col">
        <h3 class="footer-heading">Services</h3>
        <ul class="footer-links">
          <li><a href="/services/residential/">Residential Pest Control</a></li>
          <li><a href="/services/commercial/">Commercial Pest Control</a></li>
          <li><a href="/services/termite/">Termite Control</a></li>
          <li><a href="/services/mosquito/">Mosquito Control</a></li>
          <li><a href="/services/rodent/">Rodent Control</a></li>
          <li><a href="/services/bed-bug/">Bed Bug Treatment</a></li>
          <li><a href="/services/wildlife/">Wildlife Exclusion</a></li>
          <li><a href="/services/emergency/">Emergency Services</a></li>
        </ul>
      </div>
      
      <!-- Pests We Treat -->
      <div class="footer-col">
        <h3 class="footer-heading">Pests We Treat</h3>
        <ul class="footer-links">
          <li><a href="/pests/ants/">Ants</a></li>
          <li><a href="/pests/termites/">Termites</a></li>
          <li><a href="/pests/spiders/">Spiders</a></li>
          <li><a href="/pests/cockroaches/">Cockroaches</a></li>
          <li><a href="/pests/mice/">Mice & Rats</a></li>
          <li><a href="/pests/mosquitoes/">Mosquitoes</a></li>
          <li><a href="/pests/bed-bugs/">Bed Bugs</a></li>
          <li><a href="/pests/wasps/">Wasps & Bees</a></li>
        </ul>
      </div>
      
      <!-- Service Areas -->
      <div class="footer-col">
        <h3 class="footer-heading">Service Areas</h3>
        <ul class="footer-links">
          {% for state in states %}
          <li><a href="/{{ state.abbreviation | slugify }}/">{{ state.name }}</a></li>
          {% endfor %}
        </ul>
      </div>
    </div>
    
    <!-- Certifications Bar -->
    <div class="certifications-bar">
      <div class="container">
        <ul class="cert-list">
          {% for cert in site.certifications %}
          <li class="cert-item">{{ cert }}</li>
          {% endfor %}
        </ul>
      </div>
    </div>
    
    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <div class="container">
        <div class="footer-bottom-content">
          <p class="copyright">&copy; {{ "" | dateFormat("yyyy") }} {{ site.name }}. All rights reserved.</p>
          <ul class="legal-links">
            <li><a href="/privacy-policy/">Privacy Policy</a></li>
            <li><a href="/terms-of-service/">Terms of Service</a></li>
            <li><a href="/sitemap.xml">Sitemap</a></li>
            <li><a href="/accessibility/">Accessibility</a></li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
.site-footer { background: var(--text); color: white; padding: 4rem 0 0; margin-top: 4rem; }
.footer-grid { display: grid; grid-template-columns: 1fr; gap: 2rem; padding-bottom: 2rem; border-bottom: 1px solid rgba(255,255,255,0.1); }
.footer-heading { font-size: 1.1rem; font-weight: 600; margin-bottom: 1rem; color: white; }
.footer-description { color: rgba(255,255,255,0.7); margin-bottom: 1.5rem; line-height: 1.7; }
.footer-contact { display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 1.5rem; }
.footer-phone, .footer-email { display: flex; align-items: center; gap: 0.5rem; color: white; }
.footer-phone:hover, .footer-email:hover { color: var(--secondary); }
.social-links { display: flex; gap: 1rem; list-style: none; }
.social-links a { color: rgba(255,255,255,0.7); transition: color 0.2s; }
.social-links a:hover { color: var(--secondary); }
.footer-links { list-style: none; }
.footer-links li { margin-bottom: 0.5rem; }
.footer-links a { color: rgba(255,255,255,0.7); transition: color 0.2s; }
.footer-links a:hover { color: var(--secondary); }
.certifications-bar { background: rgba(255,255,255,0.05); padding: 1.5rem 0; }
.cert-list { display: flex; flex-wrap: wrap; justify-content: center; gap: 2rem; list-style: none; color: rgba(255,255,255,0.7); font-size: 0.875rem; }
.footer-bottom { padding: 1.5rem 0; }
.footer-bottom-content { display: flex; flex-direction: column; align-items: center; gap: 1rem; text-align: center; }
.copyright { color: rgba(255,255,255,0.5); font-size: 0.875rem; }
.legal-links { display: flex; flex-wrap: wrap; justify-content: center; gap: 1.5rem; list-style: none; }
.legal-links a { color: rgba(255,255,255,0.5); font-size: 0.875rem; }
.legal-links a:hover { color: white; }

@media (min-width: 768px) {
  .footer-grid { grid-template-columns: repeat(2, 1fr); }
}

@media (min-width: 1024px) {
  .footer-grid { grid-template-columns: 2fr 1fr 1fr 1fr; }
  .footer-bottom-content { flex-direction: row; justify-content: space-between; }
}
</style>
