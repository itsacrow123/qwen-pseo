<section class="hero-home" aria-label="Professional pest control services">
  <div class="hero-bg" aria-hidden="true">
    <img src="/assets/images/hero-pest-control.jpg" alt="" loading="eager" fetchpriority="high">
    <div class="hero-overlay"></div>
  </div>
  
  <div class="container hero-content">
    <div class="hero-text">
      <!-- Trust Badges -->
      <ul class="hero-badges" aria-label="Company certifications">
        {% for badge in site.trustBadges | slice(0, 4) %}
        <li class="badge-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
            <polyline points="22 4 12 14.01 9 11.01"/>
          </svg>
          {{ badge }}
        </li>
        {% endfor %}
      </ul>
      
      <h1 class="hero-title">{{ site.tagline }}</h1>
      <p class="hero-description">{{ site.description }}</p>
      
      <!-- Hero CTA Buttons -->
      <div class="hero-cta">
        <a href="tel:{{ site.phone | formatPhone }}" class="btn btn-primary btn-lg">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          Call Now - {{ site.phone }}
        </a>
        <a href="/quote/" class="btn btn-secondary btn-lg">
          Get Free Quote
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
      
      <!-- Emergency Banner -->
      {% if site.emergencyService %}
      <div class="emergency-banner">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
          <line x1="12" y1="9" x2="12" y2="13"/>
          <line x1="12" y1="17" x2="12.01" y2="17"/>
        </svg>
        <span>{{ site.emergencyHours }}</span>
      </div>
      {% endif %}
    </div>
    
    <!-- Quick Contact Form -->
    <div class="hero-form-card">
      <h2 class="form-title">Get Your Free Inspection</h2>
      <form class="quick-contact-form" action="/quote/" method="GET">
        <div class="form-group">
          <label for="service-type" class="sr-only">Service Needed</label>
          <select id="service-type" name="service" required class="form-select">
            <option value="">Select Service Needed</option>
            <option value="general-pest">General Pest Control</option>
            <option value="termites">Termite Inspection</option>
            <option value="rodents">Rodent Control</option>
            <option value="mosquitoes">Mosquito Control</option>
            <option value="bed-bugs">Bed Bug Treatment</option>
            <option value="wildlife">Wildlife Exclusion</option>
            <option value="commercial">Commercial Services</option>
            <option value="other">Other</option>
          </select>
        </div>
        <div class="form-group">
          <label for="zip-code" class="sr-only">ZIP Code</label>
          <input type="text" id="zip-code" name="zip" placeholder="Your ZIP Code" pattern="[0-9]{5}" required class="form-input" inputmode="numeric">
        </div>
        <button type="submit" class="btn btn-primary btn-block">Get Started</button>
        <p class="form-note">No obligation • Fast response • Licensed technicians</p>
      </form>
    </div>
  </div>
</section>

<style>
.hero-home { position: relative; min-height: 600px; display: flex; align-items: center; padding: 4rem 0; background: linear-gradient(135deg, #1a5f3c 0%, #0f3d26 100%); overflow: hidden; }
.hero-bg { position: absolute; inset: 0; z-index: 0; }
.hero-bg img { width: 100%; height: 100%; object-fit: cover; }
.hero-overlay { position: absolute; inset: 0; background: linear-gradient(135deg, rgba(26,95,60,0.95) 0%, rgba(15,61,38,0.9) 100%); }
.hero-content { position: relative; z-index: 1; display: grid; gap: 3rem; max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
.hero-badges { display: flex; flex-wrap: wrap; gap: 1rem; list-style: none; margin-bottom: 1.5rem; }
.badge-item { display: flex; align-items: center; gap: 0.5rem; color: rgba(255,255,255,0.9); font-size: 0.875rem; background: rgba(255,255,255,0.1); padding: 0.375rem 0.75rem; border-radius: 9999px; }
.badge-item svg { color: var(--success); flex-shrink: 0; }
.hero-title { font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 700; color: white; line-height: 1.1; margin-bottom: 1rem; }
.hero-description { font-size: clamp(1rem, 2vw, 1.25rem); color: rgba(255,255,255,0.9); max-width: 600px; margin-bottom: 2rem; line-height: 1.7; }
.hero-cta { display: flex; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem; }
.btn-lg { padding: 1rem 1.5rem; font-size: 1.1rem; font-weight: 600; display: inline-flex; align-items: center; gap: 0.5rem; border-radius: var(--radius); transition: all 0.2s; }
.btn-primary { background: var(--secondary); color: white; }
.btn-primary:hover { background: var(--secondary-hover); color: white; }
.btn-secondary { background: white; color: var(--primary); }
.btn-secondary:hover { background: rgba(255,255,255,0.9); color: var(--primary); }
.emergency-banner { display: inline-flex; align-items: center; gap: 0.75rem; background: rgba(239,68,68,0.2); border: 1px solid rgba(239,68,68,0.4); padding: 0.75rem 1rem; border-radius: var(--radius); color: #fca5a5; font-weight: 500; }
.emergency-banner svg { color: #ef4444; flex-shrink: 0; }
.hero-form-card { background: white; padding: 2rem; border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); max-width: 400px; }
.form-title { font-size: 1.5rem; font-weight: 700; color: var(--text); margin-bottom: 1.5rem; text-align: center; }
.quick-contact-form { display: flex; flex-direction: column; gap: 1rem; }
.form-select, .form-input { width: 100%; padding: 0.875rem 1rem; border: 1px solid var(--border); border-radius: var(--radius); font-size: 1rem; background: white; transition: border-color 0.2s; }
.form-select:focus, .form-input:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 3px rgba(26,95,60,0.1); }
.btn-block { width: 100%; justify-content: center; padding: 1rem; }
.form-note { text-align: center; font-size: 0.875rem; color: var(--text-light); }

@media (min-width: 1024px) {
  .hero-content { grid-template-columns: 1fr 400px; align-items: center; }
  .hero-home { min-height: 700px; }
}
</style>
