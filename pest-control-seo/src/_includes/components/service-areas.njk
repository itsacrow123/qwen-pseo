<section class="service-areas-section" aria-labelledby="areas-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="areas-heading" class="section-title">Proudly Serving All 50 States</h2>
      <p class="section-desc">From coast to coast, our network of licensed technicians provides reliable pest control services nationwide.</p>
    </div>
    
    <div class="states-grid">
      {% for state in states %}
      <a href="/{{ state.abbreviation | slugify }}/" class="state-link">{{ state.name }}</a>
      {% endfor %}
    </div>
    
    <div class="areas-cta">
      <a href="/quote/" class="btn btn-primary">Find a Technician Near You</a>
    </div>
  </div>
</section>

<style>
.service-areas-section { padding: 5rem 0; background: var(--bg-light); }
.states-grid { display: grid; gap: 0.75rem; grid-template-columns: repeat(2, 1fr); margin-bottom: 2rem; }
.state-link { display: block; padding: 0.75rem 1rem; background: white; border-radius: var(--radius); color: var(--text); font-weight: 500; transition: all 0.2s; text-align: center; }
.state-link:hover { background: var(--primary); color: white; }
.areas-cta { text-align: center; }

@media (min-width: 640px) {
  .states-grid { grid-template-columns: repeat(3, 1fr); }
}

@media (min-width: 768px) {
  .states-grid { grid-template-columns: repeat(5, 1fr); }
}

@media (min-width: 1024px) {
  .states-grid { grid-template-columns: repeat(10, 1fr); }
}
</style>
